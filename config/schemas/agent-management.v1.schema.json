{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/driftai/EveOS/config/schemas/agent-management.v1.schema.json",
  "title": "EveOS Agent Management Store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "updatedAt", "agents"],
  "properties": {
    "schema": { "const": "eveos.agent-management" },
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": ["string", "null"], "maxLength": 40 },
    "agents": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/agent" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "shortTextList": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "providerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "modelId", "profile"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "modelId": { "type": "string", "maxLength": 160 },
        "profile": { "type": "string", "maxLength": 120 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "instructions", "context", "allowedTools"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "instructions": { "type": "string", "maxLength": 12000 },
        "context": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
        },
        "allowedTools": { "$ref": "#/$defs/shortTextList" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "displayName", "role", "identity", "workingRules",
        "providerBinding", "allowedTools", "permissions", "privateNotes",
        "scopes", "provenance"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "maxLength": 240 },
        "identity": { "type": "string", "maxLength": 16000 },
        "workingRules": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "providerBinding": { "$ref": "#/$defs/providerBinding" },
        "allowedTools": { "$ref": "#/$defs/shortTextList" },
        "permissions": { "$ref": "#/$defs/shortTextList" },
        "privateNotes": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/scope" }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "updatedAt"],
          "properties": {
            "source": { "const": "local-user" },
            "updatedAt": { "type": "string", "maxLength": 40 }
          }
        }
      }
    }
  }
}
